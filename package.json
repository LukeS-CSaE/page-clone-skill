{
  "name": "page-clone-skill",
  "version": "0.0.1",
  "description": "从浏览器标签页提取完整 HTML + CSS，生成 1:1 高保真静态页面克隆",
  "main": "scripts/clone.js",
  "bin": {
    "page-clone": "scripts/clone.js",
    "list-pages": "scripts/list-pages.js"
  },
  "files": [
    "scripts/",
    "references/",
    "examples/",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clone": "node scripts/clone.js",
    "list": "node scripts/list-pages.js",
    "mcp": "node scripts/mcp-server.js",
    "prepublishOnly": "npm test",
    "test": "node -e \"console.log('No tests yet')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrome-devtools-mcp": ">=1.12.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "page-clone",
    "html-extract",
    "css-extract",
    "browser-automation",
    "chrome-devtools",
    "high-fidelity",
    "prototype",
    "mcp",
    "skill"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/moresecleft/page-clone-skill.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
